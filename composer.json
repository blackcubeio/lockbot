{
    "name": "blackcube/lockbot",
    "description": "PHP version of Lockbot Captcha",
    "keywords": ["lockbot", "captcha", "proof of work", "pow"],
    "type" : "library",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Philippe Gaultier",
            "email": "pgaultier@gmail.com"
        }
    ],
    "require": {
        "php" : "~8.3.0",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "codeception/codeception": "~5.0",
        "codeception/module-asserts": "~2.0"
    },
    "autoload": {
        "psr-4": { "blackcube\\lockbot\\": "src" }
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\": "tests/",
            "tests\\_generated\\": "tests/_support/_generated/",
            "tests\\Helper\\": "tests/_support/Helper/"
        }
    }
}
